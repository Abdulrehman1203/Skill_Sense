# ── PostgreSQL ───────────────────────────────────────────────
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ── Django ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-here
DJANGO_DEBUG=True

# Brevo transactional email. Leave SMTP_KEY empty for console email in local debug mode.
# Use the Login shown on Brevo's SMTP page and a verified From address.
SMTP_KEY=
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=

# ── Resume background processing ─────────────────────────────
# Start Redis and a Celery worker before uploading resumes in async mode.
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

# ── Clerk ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Google Calendar OAuth (Web application client). Enable the Calendar API
# and register this exact backend callback URI in Google Cloud.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/recruiters/calendar/callback/
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CALENDAR_TOKEN_KEY=
CLERK_JWKS_URL=https://your-test-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=

# ── ngrok (local webhook testing) ────────────────────────────
# Optional: claim a free static domain at https://dashboard.ngrok.com/domains
# then use:  ngrok http 8000 --url=YOUR_SUBDOMAIN.ngrok-free.app
NGROK_DOMAIN=

# ── Gemini AI  ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b
# Optional separate credential for interview grading after two retryable provider errors.
GEMINI_API_KEY_FALL_BACK=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=60000
# Raise this if a long resume reaches the output-token limit.
GEMINI_PARSE_MAX_OUTPUT_TOKENS=4096
# Optional override; when omitted, question generation uses GEMINI_MODEL_NAME.
# GEMINI_QUESTION_MODEL_NAME=
# Optional alternate Gemini model for provider outages and timeouts.
GEMINI_QUESTION_FALLBACK_MODEL_NAME=
GEMINI_QUESTION_TIMEOUT_MS=15000
# Answer evaluation uses a separate versioned contract; choose a benchmark-reviewed model.
GEMINI_EVALUATION_MODEL_NAME=gemini-3.5-flash-lite
# Optional independently verified model. Failover creates a new audit revision.
GEMINI_EVALUATION_FALLBACK_MODEL_NAME=
# Bounded wait after call end for authenticated transcript enrichment (30..900 seconds).
TRANSCRIPT_ENRICHMENT_WAIT_SECONDS=300

# ── Retell AI voice interviews ───────────────────────────────
# Keep the real API key only in the untracked .env/deployment secret store.
RETELL_API_KEY=
# Set this to the SkillSense Interviewer agent ID created in Retell.
RETELL_AGENT_ID=
RETELL_CONVERSATION_GUARD_ENABLED=False
# Public HTTPS URL ending /api/webhooks/retell/interview-control/.
RETELL_CONVERSATION_CONTROL_URL=
# Optional stable secret for encrypted short-lived browser credentials.
# Falls back to DJANGO_SECRET_KEY when blank. Keep consistent across instances.
RETELL_CREDENTIAL_ENCRYPTION_KEY=

# ── SBERT Matching  ─────────────────────────────────
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# ── S3 Storage (non-dev only) ────────────────────────────────
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Interview Analysis B1: Clerk issuer defaults to CLERK_JWKS_URL without /.well-known/jwks.json.
# Set CLERK_AUTHORIZED_PARTIES to comma-separated exact frontend origins for azp enforcement.
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
INTERVIEW_ANALYSIS_TICKET_TTL_SECONDS=30
INTERVIEW_ANALYSIS_SOCKET_LEASE_SECONDS=60
INTERVIEW_ANALYSIS_AUTH_CHECK_SECONDS=5
INTERVIEW_ANALYSIS_MAX_OUTSTANDING_TICKETS=4
INTERVIEW_ANALYSIS_CONNECTION_LEASE_SECONDS=15
INTERVIEW_ANALYSIS_RECONNECT_GRACE_SECONDS=60
INTERVIEW_ANALYSIS_VIDEO_INACTIVITY_SECONDS=120
INTERVIEW_ANALYSIS_VIDEO_STARTUP_SECONDS=120
INTERVIEW_ANALYSIS_MAX_VIDEO_SECONDS=3600
INTERVIEW_ANALYSIS_VIDEO_RECOVERY_SECONDS=5
INTERVIEW_ANALYSIS_VIDEO_RECOVERY_BATCH=100
INTERVIEW_ANALYSIS_REPORT_RECOVERY_BATCH=10
INTERVIEW_ANALYSIS_GLOBAL_FRAME_CAP=32
INTERVIEW_ANALYSIS_FRAME_DEADLINE_SECONDS=60
INTERVIEW_ANALYSIS_FRAME_CLAIM_SECONDS=30
INTERVIEW_ANALYSIS_MAX_SESSION_FRAMES=10800
# Leave disabled until staged-clip validation and target deployment acceptance pass.
INTERVIEW_ANALYSIS_VISION_ENABLED=False
INTERVIEW_TAB_VISIBILITY_ENABLED=False
INTERVIEW_SCREEN_SHARING_ENABLED=False
INTERVIEW_ANALYSIS_CAMERA_QUALITY_PROMPTS_ENABLED=False
INTERVIEW_ANALYSIS_NO_FACE_PROMPTS_ENABLED=False
INTERVIEW_ANALYSIS_GAZE_CALIBRATION_ENABLED=False
INTERVIEW_ANALYSIS_GAZE_REVIEW_ENABLED=False
INTERVIEW_ANALYSIS_CAMERA_DIAGNOSTICS_ENABLED=False
INTERVIEW_ANALYSIS_PHONE_VISIBLE_REVIEW_ENABLED=False
INTERVIEW_ANALYSIS_NO_FACE_OBSERVED_REVIEW_ENABLED=False
INTERVIEW_ANALYSIS_MULTIPLE_PEOPLE_REVIEW_ENABLED=False
# Linux worker only; 0 disables recycling. Rewarming costs/readiness gaps need measurement.
INTERVIEW_ANALYSIS_VISION_MAX_TASKS_PER_CHILD=0
# Model directory defaults to vision-artifacts inside the project.
# Set INTERVIEW_ANALYSIS_MODEL_DIRECTORY in your local .env to override it.
INTERVIEW_ANALYSIS_MAX_FACES=3
# Dedicated private, non-persistent Redis instance in production (DB isolation alone is not privacy).
INTERVIEW_ANALYSIS_PAYLOAD_PREFIX=skillsense.analysis.private
INTERVIEW_ANALYSIS_PAYLOAD_CAP=64
INTERVIEW_ANALYSIS_VISION_QUEUE=interview.analysis.vision
INTERVIEW_ANALYSIS_VISION_QUEUE_CAP=128
INTERVIEW_ANALYSIS_FINALIZATION_CLAIM_SECONDS=30

# B3: Redis primary shared by every ASGI process; no in-memory production fallback.
# Socket guard URL is GUARD_REDIS_URL (dedicated process).
INTERVIEW_ANALYSIS_REDIS_PREFIX=skillsense.analysis.guard
INTERVIEW_ANALYSIS_CHANNEL_PREFIX=skillsense.analysis.channels
INTERVIEW_ANALYSIS_WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:50893,http://localhost:50894,http://127.0.0.1:50893,http://127.0.0.1:50894
# Valid HTTP(S) loopback origins may use any port only while DJANGO_DEBUG=True.
INTERVIEW_ANALYSIS_WS_ALLOW_DEV_LOOPBACK_PORTS=True
INTERVIEW_ANALYSIS_MAX_USER_SOCKETS=4
INTERVIEW_ANALYSIS_MAX_SESSION_OBSERVERS=4
INTERVIEW_ANALYSIS_MAX_SOCKETS=64
INTERVIEW_ANALYSIS_IO_TIMEOUT_SECONDS=2
INTERVIEW_ANALYSIS_DECODE_WORKERS=2

# B7 opt-in Linux deployment overlay (examples only; review operator guide).
# DJANGO_SETTINGS_MODULE=ai_interview_recruitment.production_settings
# INTERVIEW_ANALYSIS_DEPLOY_HOSTS=api.example.invalid
# INTERVIEW_ANALYSIS_DEPLOY_ORIGINS=https://app.example.invalid
# Supply DJANGO_SECRET_KEY privately; do not copy a development/default key.
# Different Redis DB numbers do not isolate payload persistence/backups.

# Redis role isolation: six processes, not six logical databases.
# Local loopback ports below; Compose supplies service-name URLs instead.
BROKER_REDIS_URL=redis://127.0.0.1:6380/0
RESULT_REDIS_URL=redis://127.0.0.1:6381/0
CACHE_REDIS_URL=redis://127.0.0.1:6382/0
CHANNEL_REDIS_URL=redis://127.0.0.1:6383/0
GUARD_REDIS_URL=redis://127.0.0.1:6384/0
PAYLOAD_REDIS_URL=redis://127.0.0.1:6385/0
# Remove conflicting legacy REDIS_URL/CELERY_*/INTERVIEW_ANALYSIS_* URL aliases.

# Required in non-debug/production/container settings (no default production issuer).
# Issuer is an exact HTTPS origin, without a trailing slash.
CLERK_ISSUER=https://your-test-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=https://your-frontend.example
# CLERK_JWKS_URL must equal CLERK_ISSUER + /.well-known/jwks.json.
# CLERK_SECRET_KEY and CLERK_WEBHOOK_SECRET are required production secrets.

# Default SBERT all-MiniLM-L6-v2 is pinned by the application to its reviewed revision.
# Custom model names/mutable local directories require an immutable revision identity.
# SBERT_MODEL_NAME=all-MiniLM-L6-v2
# SBERT_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# Tests may opt in to offline real encoding via PHASE5_SBERT_PATH (local snapshot).

# Flutter Web live monitor pilot (server remains off by default).
LIVE_MONITOR_ENABLED=false
LIVE_MONITOR_ALLOW_DIRECT=false
LIVE_MONITOR_STUN_URLS=stun:turn.example.org:3478
LIVE_MONITOR_TURN_URLS=turn:turn.example.org:3478?transport=udp turns:turn.example.org:5349?transport=tcp
LIVE_MONITOR_TURN_SECRET=
LIVE_MONITOR_RELAY_ONLY=false

# Private Interview Replay pilot. Configure the worker and run the staging checks first.
REPLAY_CAPTURE_ENABLED=false
REPLAY_PLAYBACK_ENABLED=false
REPLAY_R2_ENDPOINT=
REPLAY_R2_BUCKET=
REPLAY_R2_ACCESS_KEY=
REPLAY_R2_SECRET_KEY=
REPLAY_BUDGET_BYTES=8000000000
REPLAY_RETENTION_DAYS=30
REPLAY_RETELL_AUDIO_HOSTS=retellai.s3.us-west-2.amazonaws.com
REPLAY_SCRATCH_DIRECTORY=
