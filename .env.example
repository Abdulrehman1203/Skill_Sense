# ── PostgreSQL ───────────────────────────────────────────────
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ── Django ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-here
DJANGO_DEBUG=True

# Notifications: production supplies a backend/provider and SMTP credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=webmaster@localhost

# ── Resume background processing ─────────────────────────────
# Start Redis and a Celery worker before uploading resumes in async mode.
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

# ── Clerk ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=

# ── ngrok (local webhook testing) ────────────────────────────
# Optional: claim a free static domain at https://dashboard.ngrok.com/domains
# then use:  ngrok http 8000 --url=YOUR_SUBDOMAIN.ngrok-free.app
NGROK_DOMAIN=

# ── Gemini AI  ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=60000
# Raise this if a long resume reaches the output-token limit.
GEMINI_PARSE_MAX_OUTPUT_TOKENS=4096
GEMINI_QUESTION_MODEL_NAME=gemini-2.5-flash
GEMINI_QUESTION_TIMEOUT_MS=7000

# ── Retell AI voice interviews ───────────────────────────────
# Keep the real API key only in the untracked .env/deployment secret store.
RETELL_API_KEY=
# Set this to the SkillSense Interviewer agent ID created in Retell.
RETELL_AGENT_ID=
# Optional stable secret for encrypted short-lived browser credentials.
# Falls back to DJANGO_SECRET_KEY when blank. Keep consistent across instances.
RETELL_CREDENTIAL_ENCRYPTION_KEY=

# ── SBERT Matching  ─────────────────────────────────
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# ── S3 Storage (non-dev only) ────────────────────────────────
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Interview Analysis B1: Clerk issuer defaults to CLERK_JWKS_URL without /.well-known/jwks.json.
# Set CLERK_AUTHORIZED_PARTIES to comma-separated exact frontend origins for azp enforcement.
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=
INTERVIEW_ANALYSIS_TICKET_TTL_SECONDS=30
INTERVIEW_ANALYSIS_SOCKET_LEASE_SECONDS=60
INTERVIEW_ANALYSIS_AUTH_CHECK_SECONDS=5
INTERVIEW_ANALYSIS_MAX_OUTSTANDING_TICKETS=4
INTERVIEW_ANALYSIS_CONNECTION_LEASE_SECONDS=15
INTERVIEW_ANALYSIS_RECONNECT_GRACE_SECONDS=30
INTERVIEW_ANALYSIS_VIDEO_INACTIVITY_SECONDS=30
INTERVIEW_ANALYSIS_MAX_VIDEO_SECONDS=3600
INTERVIEW_ANALYSIS_VIDEO_RECOVERY_SECONDS=5
INTERVIEW_ANALYSIS_VIDEO_RECOVERY_BATCH=100
INTERVIEW_ANALYSIS_REPORT_RECOVERY_BATCH=10
INTERVIEW_ANALYSIS_GLOBAL_FRAME_CAP=32
INTERVIEW_ANALYSIS_FRAME_DEADLINE_SECONDS=60
INTERVIEW_ANALYSIS_FRAME_CLAIM_SECONDS=30
INTERVIEW_ANALYSIS_MAX_SESSION_FRAMES=10800
# Leave disabled until staged-clip validation and target deployment acceptance pass.
INTERVIEW_ANALYSIS_VISION_ENABLED=False
# Linux worker only; 0 disables recycling. Rewarming costs/readiness gaps need measurement.
INTERVIEW_ANALYSIS_VISION_MAX_TASKS_PER_CHILD=0
INTERVIEW_ANALYSIS_MODEL_DIRECTORY=D:/Programming/FYP/AI_Interview_Recruitment/vision-artifacts
INTERVIEW_ANALYSIS_MAX_FACES=3
# Dedicated private, non-persistent Redis instance in production (DB isolation alone is not privacy).
INTERVIEW_ANALYSIS_PAYLOAD_REDIS_URL=redis://127.0.0.1:6379/14
INTERVIEW_ANALYSIS_PAYLOAD_PREFIX=skillsense.analysis.private
INTERVIEW_ANALYSIS_PAYLOAD_CAP=64
INTERVIEW_ANALYSIS_VISION_QUEUE=interview.analysis.vision
INTERVIEW_ANALYSIS_VISION_QUEUE_CAP=128
INTERVIEW_ANALYSIS_FINALIZATION_CLAIM_SECONDS=30

# B3: Redis primary shared by every ASGI process; no in-memory production fallback.
# INTERVIEW_ANALYSIS_REDIS_URL=redis://127.0.0.1:6379/1
INTERVIEW_ANALYSIS_REDIS_PREFIX=skillsense.analysis.guard
INTERVIEW_ANALYSIS_CHANNEL_PREFIX=skillsense.analysis.channels
INTERVIEW_ANALYSIS_WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:50893,http://localhost:50894,http://127.0.0.1:50893,http://127.0.0.1:50894
# Any valid HTTP(S) loopback port is allowed only while DJANGO_DEBUG=True.
INTERVIEW_ANALYSIS_WS_ALLOW_DEV_LOOPBACK_PORTS=True
INTERVIEW_ANALYSIS_MAX_USER_SOCKETS=4
INTERVIEW_ANALYSIS_MAX_SESSION_OBSERVERS=4
INTERVIEW_ANALYSIS_MAX_SOCKETS=64
INTERVIEW_ANALYSIS_IO_TIMEOUT_SECONDS=2
INTERVIEW_ANALYSIS_DECODE_WORKERS=2

# B7 opt-in Linux deployment overlay (examples only; review operator guide).
# DJANGO_SETTINGS_MODULE=ai_interview_recruitment.production_settings
# INTERVIEW_ANALYSIS_DEPLOY_HOSTS=api.example.invalid
# INTERVIEW_ANALYSIS_DEPLOY_ORIGINS=https://app.example.invalid
# Supply DJANGO_SECRET_KEY privately; do not copy a development/default key.
# Different Redis DB numbers do not isolate payload persistence/backups.
