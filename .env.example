# ── PostgreSQL ───────────────────────────────────────────────
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ── Django ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-here
DJANGO_DEBUG=True

# ── JWT ──────────────────────────────────────────────────────
JWT_SIGNING_KEY=your-jwt-signing-key-here
COOKIE_SECURE=False
