# Include in nginx http{} after replacing domains/certificate paths.
# Never include $request, $request_uri, $args, headers or bodies in any log.
map $http_upgrade $interview_analysis_connection { default upgrade; '' close; }
log_format interview_analysis_safe '$time_iso8601 $request_method $uri $status $request_time';
upstream interview_analysis_asgi { server 127.0.0.1:8000; }
server {
    listen 443 ssl;
    server_name api.example.invalid;
    ssl_certificate /etc/skillsense/tls/fullchain.pem;
    ssl_certificate_key /etc/skillsense/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/interview-analysis-access.log interview_analysis_safe;
    # nginx errors can include original query strings. Keep credential routes
    # off error logs; use fixed application error counters/private health reads.
    error_log /dev/null;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    location /ws/ {
        proxy_pass http://interview_analysis_asgi;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $interview_analysis_connection;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 75s;
        proxy_send_timeout 15s;
        proxy_connect_timeout 3s;
        # HTTP body caps do NOT bound WebSocket frames. Bounded Daphne does.
        client_max_body_size 300k;
    }
    location / {
        proxy_pass http://interview_analysis_asgi;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_send_timeout 30s;
        # Preserve existing upload endpoints; independently audit their limits.
        client_max_body_size 10m;
    }
}
